{
  "name": "aura-weather",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "A resilient, accessible React weather dashboard — live forecast, hourly outlook, precipitation radar, air quality, severe-weather alerts, optional rain push alerts, and source-aware data-trust cues, with offline restore and a PWA shell.",
  "keywords": [
    "weather",
    "weather-dashboard",
    "react",
    "vite",
    "pwa",
    "open-meteo",
    "accessibility",
    "portfolio",
    "radar",
    "push-notifications",
    "supabase"
  ],
  "homepage": "https://aura-weather-platform.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/itcodegirl/aura-weather.git"
  },
  "bugs": {
    "url": "https://github.com/itcodegirl/aura-weather/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:safe": "vite --configLoader runner --host 127.0.0.1 --port 5173 --strictPort false",
    "build": "vite build --configLoader runner",
    "lint": "eslint .",
    "preview": "vite preview --configLoader runner",
    "test": "node --test",
    "test:render": "node scripts/run-render-tests.mjs",
    "test:components": "npm run test:render",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:lighthouse": "npm run build && node scripts/run-lighthouse-budgets.mjs",
    "screenshots": "node scripts/run-screenshots.mjs",
    "record:trust-contract-demo": "node scripts/record-trust-contract-demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "chrome-launcher": "^1.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.8.3",
    "vite": "^8.1.5"
  }
}
